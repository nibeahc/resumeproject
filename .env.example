# 이 파일을 .env 로 복사해서 값을 채운다:  cp .env.example .env
# .env 는 gitignore 되어 있다. 키를 이 파일(.env.example)에 적어서 커밋하지 말 것.
# 셸 환경변수가 있으면 .env 보다 우선한다.

# ── 필수 (자소서 생성, 파싱, 매칭 등 LLM 을 쓰는 모든 기능) ──────────────────
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── 선택 ────────────────────────────────────────────────────────────────────
# 사용할 모델. 비워두면 lib/config.py 의 기본값을 쓴다.
MODEL=

# SQLite 파일 위치. 비워두면 data/app.db.
# 이 프로젝트 폴더가 iCloud Drive 안에 있으면 SQLite 가 동기화 중 손상될 수 있으므로
# iCloud 밖 경로를 권장한다. 예: ~/Library/Application Support/ResumeProject/app.db
DB_PATH=

# ── 선택: 채용 API (S6 공고 탐색에서만 필요, 지금은 비워둬도 된다) ────────────
# 워크넷(고용24): https://www.data.go.kr/data/3038225/openapi.do  (무료, 공공데이터포털 활용신청)
WORKNET_API_KEY=
# 사람인: https://oapi.saramin.co.kr/introduce  (키 신청 필요)
SARAMIN_API_KEY=
